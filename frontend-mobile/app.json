{
  "expo": {
    "name": "Raahi",
    "slug": "raahi-mobile",
    "scheme": "raahi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raahi.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Raahi shares your live location with trusted contacts during an active safety session.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Raahi shares your live location with trusted contacts during an active safety session, including while the app is in the background."
      }
    },
    "android": {
      "package": "com.raahi.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Raahi shares your live location with trusted contacts during an active safety session."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88c03ac1-53fa-4c79-b704-e56da3478f9b"
      }
    }
  }
}
