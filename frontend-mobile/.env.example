# Base URL of the Raahi backend API (same backend the web app used).
# On a physical device or emulator, "localhost" refers to the device itself,
# not your computer, so use your machine's LAN IP or the Android emulator alias:
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
#   Physical device  -> http://<your-computer-LAN-IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Same Geoapify key used by the web app's place autocomplete / route.ts
EXPO_PUBLIC_GEOAPIFY_API_KEY=
